# Non-secret Azure Speech configuration
AZURE_SPEECH_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com
AZURE_SPEECH_ALLOWED_HOSTS=YOUR-RESOURCE.cognitiveservices.azure.com
AZURE_SPEECH_API_VERSION=2025-10-15
SPEECH_ALLOWED_LOCALES=en-IN
SPEECH_DEFAULT_LOCALE=en-IN
SPEECH_MAX_UPLOAD_BYTES=20971520
SPEECH_MAX_DECODED_SECONDS=120
SPEECH_CONNECT_TIMEOUT_SECONDS=5
SPEECH_READ_TIMEOUT_SECONDS=60
SPEECH_WRITE_TIMEOUT_SECONDS=15
SPEECH_POOL_TIMEOUT_SECONDS=5
SPEECH_MAX_ATTEMPTS=2
SPEECH_RETRY_BASE_DELAY_SECONDS=0.25
SPEECH_RETRY_MAX_DELAY_SECONDS=2
SPEECH_PRINCIPAL_REQUESTS_PER_MINUTE=5
SPEECH_CLIENT_REQUESTS_PER_MINUTE=100
SPEECH_GLOBAL_REQUESTS_PER_MINUTE=400
SPEECH_MAX_CONCURRENCY=20
SPEECH_MAX_CONCURRENT_PER_PRINCIPAL=1
SPEECH_ADMISSION_LEASE_SECONDS=300
SPEECH_REDIS_KEY_PREFIX=speech:admission

# Secret: provide through the approved runtime secret manager, never Git.
AZURE_SPEECH_KEY=REPLACE_AT_RUNTIME_ONLY
